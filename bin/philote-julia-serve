#!/usr/bin/env python3
"""
Philote-Julia server executable.

This script serves as the entry point for the philote-julia-serve command.
"""
import sys
import os

# Add parent directory to path so we can import philote_julia
parent_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if parent_dir not in sys.path:
    sys.path.insert(0, parent_dir)

from philote_julia.cli import main

if __name__ == "__main__":
    main()
